DATABASE_URL=postgresql://rideops:rideops@localhost:5432/rideops
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ADMIN_INVITE_TOKEN=change-me-invite-token
DEV_OTP_BYPASS=123456
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# SMS provider (optional — console logger used when not set).
# MSG91 (India, DLT). Needs BOTH template IDs set to activate; otherwise the
# server logs OTPs to the console. Two DLT-approved MSG91 Flow templates:
#   • Login OTP template    — one variable named: otp
#   • Ride OTP template     — variables named: vehicle, board_otp, dboard_otp
# SMS_PROVIDER=msg91
# MSG91_AUTHKEY=
# MSG91_LOGIN_TEMPLATE_ID=
# MSG91_RIDE_TEMPLATE_ID=
# MSG91_SENDER_ID=

# Cashfree (credit-pack purchases). Get keys from the Cashfree Merchant
# Dashboard → Developers → API Keys. Use CASHFREE_ENV=sandbox for test keys.
CASHFREE_APP_ID=change-me-cashfree-app-id
CASHFREE_SECRET_KEY=change-me-cashfree-secret
CASHFREE_ENV=sandbox
# Webhook signing secret (Cashfree Dashboard → Developers → Webhooks). If unset,
# the secret key is used to verify webhook signatures.
CASHFREE_WEBHOOK_SECRET=
