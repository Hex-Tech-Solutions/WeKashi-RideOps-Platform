DATABASE_URL=postgresql://rideops:rideops@localhost:5432/rideops
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ADMIN_INVITE_TOKEN=change-me-invite-token
DEV_OTP_BYPASS=123456
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# SMS provider (optional — console logger used when not set)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Cashfree (credit-pack purchases). Get keys from the Cashfree Merchant
# Dashboard → Developers → API Keys. Use CASHFREE_ENV=sandbox for test keys.
CASHFREE_APP_ID=change-me-cashfree-app-id
CASHFREE_SECRET_KEY=change-me-cashfree-secret
CASHFREE_ENV=sandbox
# Webhook signing secret (Cashfree Dashboard → Developers → Webhooks). If unset,
# the secret key is used to verify webhook signatures.
CASHFREE_WEBHOOK_SECRET=
