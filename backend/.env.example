DATABASE_URL=postgresql://rideops:rideops@localhost:5432/rideops
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ADMIN_INVITE_TOKEN=change-me-invite-token
PORT=3000
NODE_ENV=development
# Secret for hashing Aadhaar numbers (duplicate-account matching). Generate once
# (e.g. `openssl rand -hex 32`) and NEVER change it, or existing hashes stop
# matching. Falls back to JWT_ACCESS_SECRET if unset.
IDENTITY_HASH_SECRET=
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# SMS provider (optional — console logger used when not set).
# MSG91 (India, DLT). Needs BOTH template IDs set to activate; otherwise the
# server logs OTPs to the console. MSG91 uses positional variables (##var1##…):
#   • Login OTP template  — ##var1## = OTP
#   • Ride OTP template   — ##var1## = vehicle, ##var2## = boarding OTP, ##var3## = de-boarding OTP
# SMS_PROVIDER=msg91
# MSG91_AUTHKEY=
# MSG91_LOGIN_TEMPLATE_ID=
# MSG91_RIDE_TEMPLATE_ID=
# MSG91_SENDER_ID=

# Cashfree (credit-pack purchases). Get keys from the Cashfree Merchant
# Dashboard → Developers → API Keys. Use CASHFREE_ENV=sandbox for test keys.
CASHFREE_APP_ID=change-me-cashfree-app-id
CASHFREE_SECRET_KEY=change-me-cashfree-secret
CASHFREE_ENV=sandbox
# OPTIONAL. Cashfree Payment Gateway signs webhooks with the API secret key
# above, so leave this blank. Only set it to override that.
CASHFREE_WEBHOOK_SECRET=

# Push notifications (FCM) — driver Android app. Absolute path to the Firebase
# service-account private-key JSON (Firebase Console → Project Settings →
# Service accounts → Generate new private key). SECRET — never commit it.
# When unset, push is disabled and ride broadcasts fall back to Socket.IO only.
# FCM_SERVICE_ACCOUNT_JSON=/app/secrets/fcm-service-account.json
