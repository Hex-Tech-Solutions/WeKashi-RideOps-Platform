# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
backend/node_modules/

# ── Build outputs ──────────────────────────────────────────────────────────────
dist/
dist-ssr/
backend/dist/

# ── Environment — NEVER commit secrets ────────────────────────────────────────
.env
.env.local
.env.*.local
.env.prod
backend/.env

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
.app.log

# ── Runtime / process files ───────────────────────────────────────────────────
.app.pid

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Test / coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Uploads (runtime files — never commit user data) ──────────────────────────
backend/uploads/
uploads/

# ── Binaries — should never be in git ─────────────────────────────────────────
*.apk
*.ipa
*.aab

# ── Sample / test data files ──────────────────────────────────────────────────
*.csv
ENHANCED_OTD_REPORT.csv

# ── Dead integrations (Supabase, Lovable) ─────────────────────────────────────
supabase/.branches/
supabase/.temp/

# ── Capacitor Android build ───────────────────────────────────────────────────
android/.gradle/
android/app/build/
android/build/
android/.idea/
android/*.iml

# ── Lock files (keep package-lock.json, ignore others) ───────────────────────
bun.lockb
yarn.lock
pnpm-lock.yaml

# ── Vite cache ────────────────────────────────────────────────────────────────
.vite/
