# ============================================================
# RideOps production env — used by docker-compose.prod.yml (the `api` service)
# Copy to `.env.prod` ON THE EC2 SERVER and fill in real secrets.
# DO NOT commit .env.prod.
# ============================================================

# --- Postgres (consumed by the postgres service + composed into DATABASE_URL) ---
POSTGRES_USER=rideops
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=rideops

# DATABASE_URL / REDIS_URL are set automatically in docker-compose.prod.yml.
# (api → postgres:5432, api → redis:6379 over the compose network)

# --- Auth secrets (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=CHANGE_ME_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ADMIN_INVITE_TOKEN=CHANGE_ME_invite_token

# --- Server ---
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Same-origin in production (nginx serves web + proxies /api), so the
# browser origin is just the EC2 host. Set to your public URL.
CORS_ORIGIN=http://YOUR_EC2_PUBLIC_IP

# Host port the web container binds to (80 = plain http)
WEB_PORT=80

# --- Google Maps (baked into the web build) ---
# Add the client's browser key here; redeploy to bake it into the bundle.
VITE_GOOGLE_MAPS_KEY=

# --- Razorpay (supervisor → driver ride payments) ---
# Used when supervisor pays driver for a completed ride via card/UPI/wallet.
# Driver wallet is credited; driver can withdraw to bank account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=

# --- SMS / OTP (Twilio; console logger used when unset) — see INTEGRATIONS.md ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Push notifications (FCM; see INTEGRATIONS.md) ---
# FCM_SERVICE_ACCOUNT_JSON=/app/secrets/fcm-service-account.json
