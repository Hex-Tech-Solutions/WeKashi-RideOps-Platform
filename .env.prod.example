# ============================================================
# RideOps production env — used by docker-compose.prod.yml (the `api` service)
# Copy to `.env.prod` ON THE EC2 SERVER and fill in real secrets.
# DO NOT commit .env.prod.
# ============================================================

# --- Postgres (consumed by the postgres service + composed into DATABASE_URL) ---
POSTGRES_USER=rideops
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=rideops

# DATABASE_URL / REDIS_URL are set automatically in docker-compose.prod.yml.
# (api → postgres:5432, api → redis:6379 over the compose network)

# --- Auth secrets (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=CHANGE_ME_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ADMIN_INVITE_TOKEN=CHANGE_ME_invite_token

# --- Server ---
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Same-origin in production (nginx serves web + proxies /api), so the
# browser origin is just the EC2 host. Set to your public URL.
CORS_ORIGIN=http://YOUR_EC2_PUBLIC_IP

# Host port the web container binds to (80 = plain http)
WEB_PORT=80

# --- Google Maps (baked into the web build) ---
# Add the client's browser key here; redeploy to bake it into the bundle.
VITE_GOOGLE_MAPS_KEY=

# --- Google Routes API (server-side; computeRoutes / computeRouteMatrix) ---
# IMPORTANT: enable "Routes API" for this key in Google Cloud Console — it is
# a SEPARATE product from Maps JavaScript API / Places API / Directions API.
# Can reuse the same key as VITE_GOOGLE_MAPS_KEY above as long as Routes API
# is enabled for it, but a server-only key (restricted by IP, not by referrer)
# is recommended since this one is never exposed to the browser.
GOOGLE_ROUTES_API_KEY=

# --- Azure Blob Storage (KYC documents + invoice files) ---
# Get this from Azure Portal → Storage Account → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=CHANGE_ME;AccountKey=CHANGE_ME;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=rideops-uploads

# --- Razorpay Payments (supervisor → your account) ---
# Used when supervisor pays for a completed ride via card/UPI/wallet.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=

# --- Razorpay X Payouts (driver wallet → driver bank/UPI) ---
# Separate credentials from Payments. Get from x.razorpay.com dashboard.
# IMPORTANT: allowlist your server IP in RazorpayX dashboard before using.
RAZORPAY_X_KEY_ID=
RAZORPAY_X_KEY_SECRET=
RAZORPAY_X_ACCOUNT_NUMBER=   # Your RazorpayX Current Account number (not a bank account number)
RAZORPAY_X_WEBHOOK_SECRET=   # Webhook secret from x.razorpay.com → Webhooks

# --- SMS / OTP (Twilio; console logger used when unset) — see INTEGRATIONS.md ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Push notifications (FCM; see INTEGRATIONS.md) ---
# FCM_SERVICE_ACCOUNT_JSON=/app/secrets/fcm-service-account.json
