<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".WekashiApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM service: receives ride-broadcast data messages and raises the
             full-screen incoming-ride alert. -->
        <service
            android:name=".RideFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Full-screen incoming-ride window (lock-screen wake-up path). -->
        <activity
            android:name=".IncomingRideActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- Overlay service that draws the Rapido-style card over other apps.
             shortService: it's a brief alert that finishes quickly (accept /
             reject / timeout), so it uses the standard short-service FGS type
             instead of specialUse — avoiding the extra Play review that
             specialUse triggers. -->
        <service
            android:name=".IncomingRideOverlayService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- Persistent "You're online" notification with Go Offline. This is the
             driver's on-duty location-sharing session (they stay online and
             keep sharing GPS for dispatch), so it uses the standard location
             FGS type rather than specialUse. -->
        <service
            android:name=".OnlineStatusService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Receiver for the notification's Go Offline action. -->
        <receiver
            android:name=".GoOfflineReceiver"
            android:exported="false" />

        <!-- Default FCM notification channel used by the messaging service. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ride_broadcasts" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Live driver location. FINE/COARSE cover foreground use; BACKGROUND lets
         the location foreground-service keep emitting while the driver is in
         another app (e.g. Google Maps for navigation) so the live map + trip
         odometer don't go stale. FOREGROUND_SERVICE[_LOCATION] are required on
         Android 10+/14+ to run the persistent-notification location service. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Push notifications + full-screen incoming-ride alert. POST_NOTIFICATIONS
         is the runtime notification permission (Android 13+). USE_FULL_SCREEN_INTENT
         lets the ride window wake the screen over the lock screen (Android 14+
         also exposes a per-app toggle the onboarding flow guides the driver to).
         VIBRATE for the alert; SYSTEM_ALERT_WINDOW (overlay) lets the alert draw
         over another app while the screen is unlocked. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Short-service FGS type for the brief incoming-ride overlay. (The
         location FGS type used by OnlineStatusService is already covered by
         FOREGROUND_SERVICE_LOCATION declared above.) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
