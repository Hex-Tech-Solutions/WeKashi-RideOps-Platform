# Release signing config for the Play Store build.
#
# 1. Generate an UPLOAD keystore (one time), on your build machine:
#      keytool -genkey -v -keystore wekashi-upload.jks -keyalg RSA -keysize 2048 \
#              -validity 10000 -alias wekashi-upload
#    Put wekashi-upload.jks in the android/ folder (it's git-ignored).
#
# 2. Copy this file to android/keystore.properties (git-ignored) and fill in
#    the real values below. keystore.properties is read by android/app/build.gradle
#    to sign the release AAB. NEVER commit keystore.properties or the .jks file.
#
# 3. Build the signed bundle:  cd android && ./gradlew bundleRelease
#    Output: android/app/build/outputs/bundle/release/app-release.aab

storeFile=wekashi-upload.jks
storePassword=CHANGE_ME
keyAlias=wekashi-upload
keyPassword=CHANGE_ME
